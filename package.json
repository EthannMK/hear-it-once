{
  "name": "hear-it-once",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Hear It Once — AI-assisted credit card service line prototype (SIMULATED, synthetic data only)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/server.ts",
    "db:migrate": "tsx --disable-warning=ExperimentalWarning src/db/cli.ts migrate",
    "db:seed": "tsx --disable-warning=ExperimentalWarning src/db/cli.ts seed",
    "db:reset": "tsx --disable-warning=ExperimentalWarning src/db/cli.ts reset",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scorecard": "tsx scripts/scorecard.ts",
    "test:watch": "vitest",
    "audit:deps": "npm audit --omit=dev",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:live": "tsx --disable-warning=ExperimentalWarning scripts/check-live.ts",
    "test:fuzz": "vitest run tests/fuzz",
    "test:fuzz:long": "FUZZ_RUNS=2000 vitest run tests/fuzz"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@google-cloud/bigquery": "^8.3.1",
    "@google/genai": "^2.29.1",
    "fastify": "^5.12.7",
    "google-auth-library": "^10.9.1",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
