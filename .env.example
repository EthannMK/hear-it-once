# Hear It Once — environment template. PLACEHOLDERS ONLY. Never commit a real .env.
# Copy to .env and adjust for local use.

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Persistence (SQLite file; ":memory:" for tests)
HIO_DB_PATH=./data/hear-it-once.db

# Session signing secret: REQUIRED outside tests. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value

# Demo mode: shows the simulated "registered device" one-time passcode in the simulator UI.
# Must be false for anything other than a synthetic-data demo.
DEMO_MODE=true

# Adapter mode. Only "mock" exists in this prototype. Any other value forces the
# conservative pilot policy profile (human approval of every consequential action).
ADAPTER_MODE=mock

# Policy profile: "prototype-mock" (mock-only autonomy within limits) or "pilot-conservative"
POLICY_PROFILE=prototype-mock

# Intent model: "rules" (deterministic, default, free) or "anthropic" (optional; needs key)
INTENT_MODEL=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Integration resilience
ADAPTER_TIMEOUT_MS=1500
ACTION_TIMEOUT_MS=2000
ADAPTER_READ_RETRIES=1

# Data retention (days) for transcripts of demo sessions; 0 disables purge
TRANSCRIPT_RETENTION_DAYS=30
